# Local Convex deployment (written by `pnpm exec convex dev`)
CONVEX_DEPLOYMENT=dev:your-team/your-project
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Set these on the Convex deployment, not in browser-exposed variables.
SITE_URL=http://localhost:3000
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Generated by the Convex Auth setup; never commit real values.
JWT_PRIVATE_KEY=
JWKS=

# Optional source connector. It stays "Not connected" without both values.
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
FLIPKART_AFFILIATE_API_URL=

# Optional paid marketplace feed for Amazon India, Flipkart, and Myntra.
# Set this on the Convex deployment and/or Apify Actor, never in the browser.
ANYSITE_API_TOKEN=

# Public UCP identity used by permissioned catalog connectors.
SOLESIGNAL_UCP_PROFILE_URL=https://opulent-starfish-202.convex.site/ucp-agent.json

# Optional structured attribute model provider.
ATTRIBUTE_MODEL_PROVIDER=disabled
ATTRIBUTE_MODEL_API_KEY=

# Optional WhatsApp notifications. The provider stays disabled without all values.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WHATSAPP_TEMPLATE_NAME=

# Browser tests use their own local server unless this is supplied.
PLAYWRIGHT_BASE_URL=
